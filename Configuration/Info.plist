<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Görüldü</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>WhatsApp chat export</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.plain-text</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Görüldü saves the cards you choose to your photo library.</string>
	<key>UIAppFonts</key>
	<array>
		<string>BricolageGrotesque-ExtraBold.ttf</string>
		<string>BricolageGrotesque-Bold.ttf</string>
		<string>InstrumentSans-Regular.ttf</string>
		<string>InstrumentSans-Medium.ttf</string>
		<string>InstrumentSans-SemiBold.ttf</string>
		<string>InstrumentSans-Bold.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>GorulduAPIBaseURL</key>
	<string>$(GORULDU_API_BASE_URL)</string>
	<key>GorulduAppKey</key>
	<string>$(GORULDU_APP_KEY)</string>
	<key>GorulduPrivacyURL</key>
	<string>$(GORULDU_PRIVACY_URL)</string>
	<key>GorulduTermsURL</key>
	<string>$(GORULDU_TERMS_URL)</string>
</dict>
</plist>
